#!/usr/bin/env python3
"""
Shard Registry v1.0 — Tracks all code shards and their relationships to
scripts, projects, and AI contexts.
"""
import json, os
from datetime import datetime, timezone
from pathlib import Path

REGISTRY = Path.home() / "savant/context/shard_registry.json"

### — Savant Insight —
# Purpose: ensure_registry — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:12:24
def ensure_registry():
    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    if not REGISTRY.exists():
        REGISTRY.write_text(json.dumps({"shards":[]},indent=2))

### — Savant Insight —
# Purpose: add_shard — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:12:24
def add_shard(name:str, file:str, category:str):
    ensure_registry()
    data=json.loads(REGISTRY.read_text())
    entry={"name":name,"file":file,"category":category,
           "timestamp":datetime.now(timezone.utc).isoformat()}
    data["shards"].append(entry)
    REGISTRY.write_text(json.dumps(data,indent=2))
    return entry

### — Savant Insight —
# Purpose: list_shards — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:12:24
def list_shards():
    ensure_registry()
    return json.loads(REGISTRY.read_text())

if __name__=="__main__":
    print(json.dumps(list_shards(),indent=2))


