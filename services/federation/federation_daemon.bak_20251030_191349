#!/usr/bin/env python3
"""
FederationDaemon v1.0 — persistent real-time link between Savant nodes.
Each node publishes ledger, reflex, and telemetry updates to peers.
"""
import asyncio, websockets, json, psutil, os
from datetime import datetime, timezone
from pathlib import Path

BASE = Path.home() / "savant"
LOG  = BASE / "logs/federation.log"
CONFIG = BASE / "context/federation_peers.json"

### — Savant Insight —
# Purpose: log — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:12:56
def log(msg:str):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(f"[{datetime.now(timezone.utc).isoformat()}] {msg}\n")

### — Savant Insight —
# Purpose: load_peers — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:12:56
def load_peers():
    if CONFIG.exists():
        return json.loads(CONFIG.read_text()).get("peers", [])
    return []

async def broadcast(payload:dict):
    peers = load_peers()
    for peer in peers:
        try:
            async with websockets.connect(peer) as ws:
                await ws.send(json.dumps(payload))
        except Exception as e:
            log(f"⚠️ Federation send failed to {peer}: {e}")

async def collect_telemetry():
    return {
        "cpu": psutil.cpu_percent(),
        "mem": psutil.virtual_memory().percent,
        "disk": psutil.disk_usage('/').percent,
        "time": datetime.now(timezone.utc).isoformat()
    }

async def federation_cycle():
    while True:
        payload = {
            "type": "telemetry",
            "origin": os.uname().nodename,
            "data": await collect_telemetry()
        }
        await broadcast(payload)
        log(f"🔗 Broadcasted federation telemetry: {payload['data']}")
        await asyncio.sleep(60)

if __name__ == "__main__":
    print("🌐 Savant FederationDaemon active — realtime sync every 60 s")
    asyncio.run(federation_cycle())


