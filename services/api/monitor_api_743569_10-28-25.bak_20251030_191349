from flask import Flask, jsonify
import psutil, time, os, hashlib
from pathlib import Path

ROOT = Path.home()/ "savant"
LOGS = ROOT/"logs"
CACHE = ROOT/"integrity_cache"
CACHE.mkdir(exist_ok=True, parents=True)

### — Savant Insight —
# Purpose: hash_log — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:06:46
def hash_log(f):
    h=hashlib.md5()
    try:
        with open(f,"rb") as fd:
            for c in iter(lambda:fd.read(4096),b""): h.update(c)
        return h.hexdigest()[:12]
    except: return "none"

### — Savant Insight —
# Purpose: read_log_tail — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:06:46
def read_log_tail(p,n=10):
    try:
        return "\n".join(open(p).read().splitlines()[-n:])
    except: return ""

### — Savant Insight —
# Purpose: proc — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:06:46
def proc(name): 
    for p in psutil.process_iter(['pid','cmdline']):
        if name in " ".join(p.info['cmdline']): return True
    return False

app = Flask(__name__)

@app.route("/status")
### — Savant Insight —
# Purpose: status — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:06:46
def status():
    data={
      "timestamp":time.strftime("%Y-%m-%d %H:%M:%S"),
      "daemons":{
        "realtime_watcher":proc("realtime_watcher.py"),
        "self_diagnostic":proc("self_diagnostic.py"),
        "master_guard":proc("master_guard.py")
      },
      "logs":{
        "realtime":hash_log(LOGS/"realtime_daemon.out"),
        "diagnostic":hash_log(LOGS/"self_diagnostic.out"),
        "guard":hash_log(LOGS/"automation_daemon.out")
      }
    }
    (CACHE/"status.json").write_text(str(data))
    return jsonify(data)

@app.route("/tail/<logname>")
### — Savant Insight —
# Purpose: tail — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:06:46
def tail(logname):
    logmap={"realtime":"realtime_daemon.out","diagnostic":"self_diagnostic.out","guard":"automation_daemon.out"}
    if logname not in logmap: return jsonify({"error":"unknown log"})
    p=LOGS/logmap[logname]
    return jsonify({"file":logmap[logname],"tail":read_log_tail(p)})

