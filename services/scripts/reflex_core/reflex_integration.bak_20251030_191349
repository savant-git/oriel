"""
Savant Reflex Integration — bridges Reflex Engine ↔ AI Core Gateway.
Evaluates system health, adjusts parameters, and reports to the Command Bus.
"""
import asyncio, json, os, time, pathlib, requests, psutil
from datetime import datetime, timezone
from savant.services.scripts.reflex_core.reflex_engine import analyze_cycle

LOG = pathlib.Path.home() / "savant/logs/reflex_integration.log"
AI_API = "http://127.0.0.1:8000/api/ai"

def adjust_ai_core():
    data = analyze_cycle()
    payload = {
        "prompt": f"Recalibrate AI parameters based on system health {data}",
    }
    try:
        res = requests.post(AI_API, json=payload, timeout=10)
        LOG.write_text(json.dumps({"time":datetime.now(timezone.utc).isoformat(),
                                   "result":data,"response":res.text}, indent=2))
        print("🧬 Reflex→AI synchronization complete.")
    except Exception as e:
        print("⚠️ Reflex integration failed:", e)

async def reflex_daemon(interval=300):
    while True:
        adjust_ai_core()
        await asyncio.sleep(interval)

if __name__=="__main__":
    asyncio.run(reflex_daemon())


