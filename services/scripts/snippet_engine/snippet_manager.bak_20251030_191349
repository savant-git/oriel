#!/usr/bin/env python3
import json, pathlib, datetime
from rich.console import Console
console = Console()

class SnippetManager:
    def __init__(self):
        self.lib_path = pathlib.Path("~/savant/snippet_library/snippets.json").expanduser()
        self.lib_path.parent.mkdir(parents=True, exist_ok=True)
        if not self.lib_path.exists(): self.lib_path.write_text("{}")

    def add_snippet(self,name:str,code:str):
        data=json.loads(self.lib_path.read_text())
        data[name]={"code":code,"uses":0,"created":str(datetime.datetime.utcnow())}
        self.lib_path.write_text(json.dumps(data,indent=2))
        console.print(f"[green]🧩 Snippet '{name}' added.[/green]")

    def use_snippet(self,name:str,file_path:str):
        data=json.loads(self.lib_path.read_text())
        if name not in data:
            console.print(f"[red]⚠ Snippet '{name}' not found.[/red]")
            return
        data[name]["uses"]+=1
        ulog=pathlib.Path("~/savant/snippet_library/usage.log").expanduser()
        with ulog.open("a") as f:
            f.write(f"{datetime.datetime.utcnow()} | {name} -> {file_path}\n")
        self.lib_path.write_text(json.dumps(data,indent=2))
        console.print(f"[cyan]Inserted snippet '{name}' into {file_path}[/cyan]")

    def list_snippets(self):
        data=json.loads(self.lib_path.read_text())
        for k,v in data.items():
            console.print(f"{k} — {v['uses']} uses — created {v['created']}")


