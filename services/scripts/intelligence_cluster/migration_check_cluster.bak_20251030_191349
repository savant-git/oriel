#!/data/data/com.termux/files/usr/bin/python3
"""
🧭 SAVANT MIGRATION READINESS CLUSTER v1.3
Adds full OpenAI project/org support for sk-proj keys.
"""

import os, sys, json, tempfile, requests, boto3
from datetime import datetime, timezone
from pathlib import Path

BASE = Path.home() / "savant"
LOG_PATH = BASE / "logs" / "migration_check.json"
ENV_PATH = BASE / ".env"

def load_env():
    if not ENV_PATH.exists():
        print(f"❌ No .env found at {ENV_PATH}")
        sys.exit(1)
    for line in open(ENV_PATH):
        if "=" in line and not line.strip().startswith("#"):
            k, v = line.strip().split("=", 1)
            os.environ[k] = v
    print(f"✅ Environment loaded from {ENV_PATH}")

def test_openai():
    print("\n🔑 Testing OpenAI API connection...")
    try:
        from openai import OpenAI
        key = os.getenv("OPENAI_API_KEY")
        org = os.getenv("OPENAI_ORG_ID")
        project = os.getenv("OPENAI_PROJECT_ID")
        if not key:
            raise ValueError("OPENAI_API_KEY missing in .env")

        client = OpenAI(
            api_key=key,
            organization=org if org else None,
            project=project if project else None
        )

        resp = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[{"role": "user", "content": "say 'ready'"}]
        )
        print(f"✅ OpenAI responded: {resp.choices[0].message.content.strip()}")
        return True

    except Exception as e:
        print(f"❌ OpenAI test failed: {e}")
        return False

def test_github():
    print("\n🐙 Testing GitHub token...")
    try:
        token = os.getenv("GITHUB_TOKEN")
        user = os.getenv("GITHUB_USER", "flypaper-creative")
        repo = os.getenv("GITHUB_REPO", "savant")
        r = requests.get("https://api.github.com/user",
                         headers={"Authorization": f"token {token}"})
        if r.status_code == 200:
            print(f"✅ GitHub authenticated as: {r.json().get('login')}")
            return True
        print(f"⚠️ GitHub returned {r.status_code}: {r.text}")
        return False
    except Exception as e:
        print(f"❌ GitHub test failed: {e}")
        return False

def test_s3():
    print("\n☁️  Testing S3 connectivity...")
    try:
        s3 = boto3.client(
            "s3",
            aws_access_key_id=os.getenv("AWS_ACCESS_KEY_ID"),
            aws_secret_access_key=os.getenv("AWS_SECRET_ACCESS_KEY"),
            region_name=os.getenv("AWS_DEFAULT_REGION", "us-east-1")
        )
        bucket = os.getenv("SAVANT_S3_BUCKET")
        tmp = Path(tempfile.gettempdir()) / "savant_test.txt"
        tmp.write_text("savant cloud test\n")
        key = f"diagnostics/{tmp.name}"
        s3.upload_file(str(tmp), bucket, key)
        print(f"✅ Uploaded test file to s3://{bucket}/{key}")
        return True
    except Exception as e:
        print(f"❌ S3 test failed: {e}")
        return False

def main():
    print(f"\n🧠 Starting Savant Migration Check at {datetime.now().isoformat()}")
    load_env()
    oai = test_openai()
    gh = test_github()
    s3 = test_s3()
    all_ok = all([oai, gh, s3])
    print("\n✅ Ready." if all_ok else "\n⚠️  Not fully connected yet.")

if __name__ == "__main__":
    main()
