#!/usr/bin/env python3
"""
SAVANT AUTO-LEARNING SUPERVISOR (patched)
- Tracks cycles in ~/savant/context/auto_learning_state.json
- Every 3 cycles runs compact_shards.py to prune historical shard variants.
- Falls back gracefully if compactor or context dir missing.
"""
import os, json, subprocess
from pathlib import Path
from datetime import datetime

BASE = Path("~/savant").expanduser()
CTX = BASE / "context"
CTX.mkdir(parents=True, exist_ok=True)
STATE = CTX / "auto_learning_state.json"
COMPACTOR = Path("~/savant/services/scripts/intelligence_cluster/compact_shards.py").expanduser()

def load_state():
    if STATE.exists():
        try:
            return json.loads(STATE.read_text())
        except Exception:
            pass
    return {"cycles": 0, "last_run": None}

def save_state(s):
    STATE.write_text(json.dumps(s, indent=2))

def maybe_compact(cycles):
    if cycles % 3 != 0:
        return False, "skip"
    if not COMPACTOR.exists():
        return False, "compactor_missing"
    try:
        # Keep only newest per stem, move older to trash
        cmd = ["python3", str(COMPACTOR), "--keep", "1"]
        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True)
        return True, out
    except subprocess.CalledProcessError as e:
        return False, f"error: {e.output}"
    except Exception as e:
        return False, f"exception: {e}"

def main():
    st = load_state()
    st["cycles"] = st.get("cycles", 0) + 1
    st["last_run"] = datetime.now().isoformat()

    compacted, info = maybe_compact(st["cycles"])
    save_state(st)

    print(f"🧠 Auto-Learning Supervisor cycle: {st['cycles']}")
    if compacted:
        print("🧹 Compact Mode triggered:\n" + info)
    else:
        print(f"ℹ️  Compact Mode: {info}")

if __name__ == "__main__":
    main()
