#!/usr/bin/env python3
"""
Chat Log Ingestor — Provenance Recorder
---------------------------------------
Aggregates every ChatGPT <-> Savant exchange
into a canonical export bundle for archival integrity.
"""
import os, re, json
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path.home() / "savant"
CHAT = ROOT / "logs" / "chat_history_full.txt"
EXPORT_LOG = ROOT / "logs" / "chat_ingestor.log"
TARGET = ROOT / "exports" / f"chat_export_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"

def collect_sources()->list[Path]:
    base = ROOT / "logs"
    return [p for p in base.glob("*.log")] + [CHAT] if CHAT.exists() else [p for p in base.glob("*.log")]

def aggregate():
    text = ""
    for f in collect_sources():
        try: text += f"\n\n# --- {f.name} ---\n" + f.read_text(errors="ignore")
        except: continue
    return text

def write_export(content:str):
    TARGET.parent.mkdir(parents=True, exist_ok=True)
    TARGET.write_text(content, encoding="utf-8")
    EXPORT_LOG.write_text(f"[{datetime.now(timezone.utc).isoformat()}] Chat archive written to {TARGET}\n", encoding="utf-8")

if __name__ == "__main__":
    content = aggregate()
    if content.strip():
        write_export(content)
        print(f"✅ Chat history exported → {TARGET}")
    else:
        print("⚠️ No chat content found.")
