#!/usr/bin/env python3
"""
SAVANT CLOUD RECOVERY v1.0
Downloads and restores the latest S3 export archive automatically.
"""
import os, boto3, zipfile, shutil
from datetime import datetime
from pathlib import Path
from dotenv import load_dotenv

BASE = Path.home() / "savant"
EXPORTS = BASE / "archive"
EXPORTS.mkdir(parents=True, exist_ok=True)
load_dotenv(BASE / ".env")

def get_s3():
    return boto3.client(
        "s3",
        aws_access_key_id=os.getenv("AWS_ACCESS_KEY_ID"),
        aws_secret_access_key=os.getenv("AWS_SECRET_ACCESS_KEY"),
        region_name=os.getenv("AWS_DEFAULT_REGION", "us-east-1")
    )

def download_latest():
    bucket = os.getenv("SAVANT_S3_BUCKET")
    if not bucket:
        print("⚠️  No bucket set in .env")
        return None
    s3 = get_s3()
    objs = s3.list_objects_v2(Bucket=bucket, Prefix="exports/")
    if "Contents" not in objs:
        print("⚠️  No exports found in bucket.")
        return None
    latest = max(objs["Contents"], key=lambda x: x["LastModified"])
    key = latest["Key"]
    local = EXPORTS / Path(key).name
    print(f"⬇️  Downloading {key} → {local}")
    s3.download_file(bucket, key, str(local))
    print(f"✅ Downloaded latest archive.")
    return local

def restore_archive(archive_path: Path):
    dest = BASE
    print(f"🧩 Restoring archive → {dest}")
    with zipfile.ZipFile(archive_path, "r") as zf:
        zf.extractall(dest)
    print(f"✅ Restoration complete → {archive_path.name}")

if __name__ == "__main__":
    print(f"\n🧠 Starting Savant Cloud Recovery at {datetime.now().isoformat()}")
    latest = download_latest()
    if latest:
        restore_archive(latest)
        print("✅ Full recovery finished.")
    else:
        print("⚠️  No valid archive to restore.")
