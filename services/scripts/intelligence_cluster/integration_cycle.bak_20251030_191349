import os
import json
import pathlib
import subprocess
from datetime import datetime
from openai import OpenAI

# Define constants for base directory and log file path
BASE = pathlib.Path.home() / "savant"
LOG_PATH = BASE / "logs" / "integration_cycle.json"

# Initialize OpenAI client with the API key from environment variables
client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))

def log(event, data=None):
    """
    Log an event with optional data to a JSON file.

    Args:
        event (str): The event name to log.
        data (dict, optional): Additional data to log with the event.
    """
    # Ensure the log directory exists
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    
    # Create a log entry with the current timestamp
    entry = {
        "time": datetime.now().isoformat(),
        "event": event,
        "data": data or {}
    }
    
    # Append the log entry to the log file
    with open(LOG_PATH, "a") as f:
        f.write(json.dumps(entry) + "\n")

def run_cycle():
    """
    Execute the integration cycle for Savant AI, including OpenAI connection validation,
    knowledge synthesis, and syncing with cloud and GitHub.
    """
    print(f"\n🧠 Starting Savant Integration Cycle at {datetime.now().isoformat()}")
    log("integration_start")

    # 1️⃣ Validate OpenAI connection
    try:
        models = [m.id for m in client.models.list().data]
        print(f"✅ OpenAI connected — {len(models)} models available.")
        log("openai_models", {"count": len(models)})
    except Exception as e:
        print(f"❌ OpenAI check failed: {e}")
        log("openai_error", {"error": str(e)})
        return

    # 2️⃣ Knowledge synthesis
    print("📚 Generating domain synthesis...")
    synthesis_prompt = "Summarize Savant AI’s purpose and current architecture."
    try:
        resp = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[
                {"role": "system", "content": "You are Savant AI."},
                {"role": "user", "content": synthesis_prompt}
            ]
        )
        summary = resp.choices[0].message.content.strip()
        print(f"📘 Synthesis complete:\n{summary[:250]}...")
        log("synthesis_summary", {"summary": summary})
    except Exception as e:
        print(f"⚠️  Synthesis failed: {e}")
        log("synthesis_error", {"error": str(e)})

    # 3️⃣ Cloud + GitHub sync
    print("☁️  Syncing cloud + GitHub...")
    try:
        subprocess.run(
            ["python3", str(BASE / "services/scripts/cloud_engine/cloud_uplink.py"), str(BASE / "archive")],
            check=True
        )
        subprocess.run(
            ["python3", str(BASE / "services/scripts/intelligence_cluster/export_cluster.py")],
            check=True
        )
    except subprocess.CalledProcessError as e:
        print(f"⚠️  Sync failed: {e}")
        log("sync_error", {"error": str(e)})

    print("\n✅ Integration cycle complete.")
    log("integration_complete")

if __name__ == "__main__":
    run_cycle()
