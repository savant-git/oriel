if __name__ == "__main__":
    try:
        target = input("Enter target directory to scan, clean, and complete: ").strip() or "~/savant/services"
    except EOFError:
        target = "~/savant/services"
    cluster = CleanCompleteCluster()
    cluster.execute(target)


