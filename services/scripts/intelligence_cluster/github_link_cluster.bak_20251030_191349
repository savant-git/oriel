import os
import subprocess
from datetime import datetime

def main():
    print(f"\n🐙 Starting GitHub Link Cycle at {datetime.now().isoformat()}")

    user = "flypaper-creative"
    repo = "savant"
    token = os.getenv("GITHUB_TOKEN")

    # Check for the required GitHub token
    if not token:
        print("❌ No GITHUB_TOKEN found — please check your .env file.")
        raise SystemExit(1)

    remote_url = f"https://{user}:{token}@github.com/{user}/{repo}.git"
    repo_path = os.path.expanduser("~/savant")

    # Initialize the repository if it does not exist
    initialize_repository(repo_path)

    # Set the remote URL for the repository
    set_remote(repo_path, remote_url)

    # Commit changes and push to GitHub
    commit_and_push(repo_path)

def initialize_repository(repo_path):
    """Initialize the Git repository if it does not exist."""
    if not os.path.exists(os.path.join(repo_path, ".git")):
        print("🔄 Initializing new Git repository...")
        subprocess.run(["git", "-C", repo_path, "init"], check=True)

def set_remote(repo_path, remote_url):
    """Set the remote origin for the Git repository."""
    print("🔗 Setting remote origin...")
    subprocess.run(["git", "-C", repo_path, "remote", "remove", "origin"], stderr=subprocess.DEVNULL)
    subprocess.run(["git", "-C", repo_path, "remote", "add", "origin", remote_url], check=True)

def commit_and_push(repo_path):
    """Add changes, commit them, and push to the remote repository."""
    print("📦 Adding changes to the repository...")
    subprocess.run(["git", "-C", repo_path, "add", "."], check=True)

    commit_message = f"Automated migration lock {datetime.now().isoformat()}"
    print(f"📝 Committing changes: {commit_message}")
    subprocess.run(["git", "-C", repo_path, "commit", "-m", commit_message], check=True)

    print("📈 Pushing changes to GitHub...")
    subprocess.run(["git", "-C", repo_path, "branch", "-M", "main"], check=True)
    result = subprocess.run(["git", "-C", repo_path, "push", "-u", "origin", "main"], capture_output=True, text=True)

    # Check the result of the push operation
    if result.returncode == 0:
        print("✅ GitHub push complete — Savant repository synced successfully.")
    else:
        print("⚠️ GitHub push failed:")
        print(result.stderr)

if __name__ == "__main__":
    main()
