#!/data/data/com.termux/files/usr/bin/python3
"""
🧠 SAVANT SMART EXPORT v4.0 — Ultimate Compact Cloud Sync
Creates a minimal export snapshot, compresses, uploads to S3,
copies to Downloads, and syncs with GitHub.
"""

import os, sys, json, shutil, zipfile, tempfile, subprocess
from datetime import datetime, timezone
from pathlib import Path

# --- Base paths ------------------------------------------------------
BASE = Path.home() / "savant"
EXPORTS = BASE / "exports"
EXPORTS.mkdir(parents=True, exist_ok=True)
LOG_PATH = BASE / "logs" / "export_log.json"
DOWNLOADS = Path.home() / "storage" / "downloads"

# --- Cloud / GitHub env ----------------------------------------------
if (Path.home() / ".env").exists():
    for line in open(Path.home() / ".env"):
        if "=" in line:
            k, v = line.strip().split("=", 1)
            os.environ[k] = v

S3_KEY = os.getenv("AWS_ACCESS_KEY_ID")
S3_SECRET = os.getenv("AWS_SECRET_ACCESS_KEY")
S3_BUCKET = os.getenv("SAVANT_S3_BUCKET")
S3_REGION = os.getenv("AWS_DEFAULT_REGION", "us-east-1")
GITHUB_TOKEN = os.getenv("GITHUB_TOKEN")
GITHUB_USER = os.getenv("GITHUB_USER", "flypaper-creative")
REPO_NAME = "savant"

# --- Utility ----------------------------------------------------------
def human_size(num):
    for unit in ['B','KB','MB','GB','TB']:
        if num < 1024: return f"{num:.1f} {unit}"
        num /= 1024
    return f"{num:.1f} TB"

def log_event(event_type, payload):
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    entry = {
        "time": datetime.now(timezone.utc).isoformat(),
        "type": event_type,
        "payload": payload
    }
    with open(LOG_PATH, "a") as f:
        f.write(json.dumps(entry) + "\n")

# --- 1️⃣ Pre-clean redundant files ------------------------------------
def pre_clean():
    print("🧹 Removing caches, builds, and redundant files...")
    patterns = [
        "__pycache__", "node_modules", ".pytest_cache", ".mypy_cache",
        ".ruff_cache", "dist", "build", ".git", "*.log", "*.tmp",
        "*.zip", "*.tar", "*.zst", "*.gz"
    ]
    removed = 0
    for pattern in patterns:
        for p in BASE.rglob(pattern):
            try:
                if p.is_dir():
                    shutil.rmtree(p, ignore_errors=True)
                    removed += 1
                elif p.is_file():
                    p.unlink()
                    removed += 1
            except Exception:
                pass
    print(f"✅ Pre-clean complete — {removed} items removed.")
    return removed

# --- 2️⃣ Build minimal structure --------------------------------------
def build_minimal_copy():
    print("📦 Building minimal export structure...")
    essential_exts = {".py",".env",".json",".md",".yml",".yaml",".ini",".toml",".cfg",".sh"}
    tmpdir = Path(tempfile.mkdtemp(prefix="savant_export_"))
    kept, skipped = 0, 0
    for path in BASE.rglob("*"):
        rel = path.relative_to(BASE)
        if path.is_dir():
            (tmpdir / rel).mkdir(parents=True, exist_ok=True)
        elif path.suffix in essential_exts:
            try:
                shutil.copy2(path, tmpdir / rel)
                kept += 1
            except Exception:
                skipped += 1
        else:
            skipped += 1
    print(f"✅ Minimal copy complete — kept {kept}, skipped {skipped}.")
    return tmpdir

# --- 3️⃣ Compress -----------------------------------------------------
def compress_dir(src_dir: Path):
    now = datetime.now().strftime("%Y%m%d_%H%M%S")
    archive_name = f"savant_compact_{now}.zip"
    out_path = EXPORTS / archive_name
    print(f"🧩 Compressing → {out_path}")
    with zipfile.ZipFile(out_path, "w", zipfile.ZIP_DEFLATED) as zf:
        for path in src_dir.rglob("*"):
            if path.is_file():
                zf.write(path, path.relative_to(src_dir))
    size = out_path.stat().st_size
    print(f"✅ Archive created — {human_size(size)}")
    return out_path

# --- 4️⃣ Copy to Downloads -------------------------------------------
def copy_to_downloads(path: Path):
    try:
        DOWNLOADS.mkdir(parents=True, exist_ok=True)
        target = DOWNLOADS / path.name
        shutil.copy2(path, target)
        print(f"📥 Copied to Downloads → {target}")
    except Exception as e:
        print(f"⚠️ Copy failed: {e}")

# --- 5️⃣ Upload to S3 -------------------------------------------------
def upload_to_s3(path: Path):
    if not all([S3_KEY, S3_SECRET, S3_BUCKET]):
        print("⚠️  S3 not configured, skipping upload.")
        return
    try:
        import boto3
        s3 = boto3.client("s3",
            aws_access_key_id=S3_KEY,
            aws_secret_access_key=S3_SECRET,
            region_name=S3_REGION
        )
        key = f"exports/{path.name}"
        s3.upload_file(str(path), S3_BUCKET, key)
        print(f"✅ Uploaded to s3://{S3_BUCKET}/{key}")
    except Exception as e:
        print(f"⚠️  Upload failed: {e}")

# --- 6️⃣ GitHub Sync --------------------------------------------------
def github_push(path: Path):
    if not GITHUB_TOKEN:
        print("⚠️ No GitHub token — skipping push.")
        return
    try:
        subprocess.run(["git", "init"], cwd=BASE, check=True)
        subprocess.run(["git", "config", "user.name", GITHUB_USER], cwd=BASE, check=True)
        subprocess.run(["git", "config", "user.email", f"{GITHUB_USER}@users.noreply.github.com"], cwd=BASE, check=True)
        subprocess.run(["git", "remote", "remove", "origin"], cwd=BASE, check=False)
        subprocess.run(["git", "remote", "add", "origin", f"https://{GITHUB_TOKEN}@github.com/{GITHUB_USER}/{REPO_NAME}.git"], cwd=BASE, check=False)
        subprocess.run(["git", "add", "."], cwd=BASE, check=True)
        subprocess.run(["git", "commit", "-m", f"Automated export {datetime.now().isoformat()}"], cwd=BASE, check=True)
        subprocess.run(["git", "branch", "-M", "main"], cwd=BASE, check=False)
        subprocess.run(["git", "push", "-u", "origin", "main", "--force"], cwd=BASE, check=True)
        print("🐙 GitHub sync complete.")
    except Exception as e:
        print(f"⚠️  GitHub sync failed: {e}")

# --- 7️⃣ MAIN ---------------------------------------------------------
def main():
    print(f"\n🧠 Starting Savant Smart Export at {datetime.now().isoformat()}")
    total_files = sum(1 for _ in BASE.rglob("*"))
    total_size = sum(f.stat().st_size for f in BASE.rglob("*") if f.is_file())
    print(f"📊 Before cleanup → {total_files} files, {human_size(total_size)}")

    pre_clean()
    tmpdir = build_minimal_copy()
    archive = compress_dir(tmpdir)
    copy_to_downloads(archive)
    upload_to_s3(archive)
    github_push(archive)

    final_size = archive.stat().st_size
    ratio = (1 - final_size / total_size) * 100 if total_size else 0
    print(f"\n📦 Final archive: {archive.name} — {human_size(final_size)}")
    print(f"💾 Compression ratio: {ratio:.2f}% smaller than original")
    print("✅ Export complete.")

    log_event("export_complete", {
        "archive": str(archive),
        "final_size": final_size,
        "compression_ratio": ratio
    })

if __name__ == "__main__":
    main()
