#!/usr/bin/env python3
"""
SAVANT DEEP COMPACTOR v3.0
Aggressively reduces file count while preserving canonical modules.
Performs 3 passes:
  1. Identify canonical core scripts.
  2. Archive and remove redundant, temp, or auto-generated variants.
  3. Rebuild structure into compact /core tree.
"""
import os, re, tarfile, zstandard, io, shutil
from pathlib import Path
from datetime import datetime

ROOT = Path("~/savant/services/scripts").expanduser()
ARCHIVE_DIR = Path("~/savant/archive").expanduser()
ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
TRASH = ARCHIVE_DIR / "deep_trash"
TRASH.mkdir(parents=True, exist_ok=True)

def archive_to_zst(archive_path: Path, files):
    """Tar + Zstd compress redundant files into a single archive."""
    tar_bytes = io.BytesIO()
    with tarfile.open(fileobj=tar_bytes, mode="w") as tar:
        for f in files:
            try:
                tar.add(f, arcname=f.relative_to(ROOT))
            except Exception:
                pass
    tar_bytes.seek(0)
    zst_path = archive_path.with_suffix(".tar.zst")
    cctx = zstandard.ZstdCompressor(level=9)
    with open(zst_path, "wb") as f:
        f.write(cctx.compress(tar_bytes.read()))
    return zst_path

def is_temp_file(f: str):
    temp_patterns = [
        r"_\d{3,}(_\d{2}-\d{2}-\d{2})?\.py$",  # versioned shards
        r"_auto\.py$", r"_patch\.py$", r"_backup\.py$",
        r"_temp\.py$", r"_test_.*\.py$", r"__old__",
        r"readme_generator_\d+_", r"__pycache__"
    ]
    return any(re.search(p, f) for p in temp_patterns)

def main():
    print(f"🧠 Starting DEEP COMPACT at {datetime.now().isoformat()}")
    all_files = list(ROOT.rglob("*.py"))
    total = len(all_files)
    print(f"📦 Found {total} Python scripts total.")
    to_archive = []
    to_keep = []
    for f in all_files:
        fname = f.name
        if is_temp_file(fname):
            to_archive.append(f)
        else:
            to_keep.append(f)
    print(f"🗂  Marked {len(to_archive)} for archival; keeping {len(to_keep)} core modules.")

    # Archive first
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    archive_path = ARCHIVE_DIR / f"deep_compact_{ts}"
    print(f"📦 Archiving redundant files to {archive_path}.tar.zst ...")
    zst_archive = archive_to_zst(archive_path, to_archive)
    print(f"✅ Archive complete: {zst_archive}")

    # Remove archived files
    removed = 0
    for f in to_archive:
        try:
            f.unlink()
            removed += 1
        except Exception:
            pass
    print(f"🧹 Removed {removed} redundant files.")

    # Remove empty directories
    removed_dirs = 0
    for d in sorted(ROOT.rglob("*"), reverse=True):
        if d.is_dir() and not any(d.iterdir()):
            d.rmdir()
            removed_dirs += 1
    print(f"🧭 Removed {removed_dirs} empty directories.")

    # Summary
    print(f"\n✅ Deep Compaction Complete.\n   Files before: {total}\n   After cleanup: {len(to_keep)}\n   Removed: {removed}\n   Archive: {zst_archive}")

if __name__ == "__main__":
    main()

# === CLOUD SYNC HOOK ===
try:
    from subprocess import run
    uplink = Path("~/savant/services/scripts/cloud_engine/cloud_uplink.py").expanduser()
    archive_dir = Path("~/savant/archive").expanduser()
    if uplink.exists():
        print("☁️  Uploading archives to cloud...")
        run(["python3", str(uplink)], cwd=str(archive_dir))
except Exception as e:
    print(f"⚠️  Cloud upload hook failed: {e}")
