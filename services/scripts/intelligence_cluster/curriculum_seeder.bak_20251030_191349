"""
SAVANT CURRICULUM SEEDER — v2.1
- Reads seeds from:   ~/savant/knowledge/seeds/*.txt
- Respects robots.txt
- Dedupes by URL + content hash
- Extracts text from HTML/PDF/TXT/MD
- Parallel, resumable, rate-limited
- Writes:
    - knowledge/source/<hash>.<ext>     (original)
    - knowledge/raw_text/<hash>.txt     (normalized text)
    - knowledge/meta/ingest.jsonl       (metadata rows)
Requires: requests, bs4, pdfminer.six
"""
import os, sys, time, json, pathlib, mimetypes, concurrent.futures, urllib.parse
from datetime import datetime, timezone
from typing import List, Dict, Tuple
import requests
from bs4 import BeautifulSoup
from urllib.robotparser import RobotFileParser

# PDF
from io import BytesIO
from pdfminer.high_level import extract_text as pdf_extract_text

BASE  = pathlib.Path(os.path.expanduser("~/savant"))
KDIR  = BASE / "knowledge"
SEEDS = KDIR / "seeds"
SRC   = KDIR / "source"
RAW   = KDIR / "raw_text"
META  = KDIR / "meta"
TMP   = KDIR / "tmp"
LOGS  = BASE / "logs"
for p in [KDIR, SEEDS, SRC, RAW, META, TMP, LOGS]: p.mkdir(parents=True, exist_ok=True)

TIMEOUT = 25
MAX_WORKERS = 8
MAX_BYTES = 25 * 1024 * 1024  # 25MB hard cap per file
RATE_LIMIT_PER_HOST = 1.0     # sec between reqs per host

# --- trivial per-host limiter
_last_hit = {}
def rate_limit(url: str):
    host = urllib.parse.urlparse(url).netloc
    now = time.time()
    last = _last_hit.get(host, 0.0)
    delta = now - last
    if delta < RATE_LIMIT_PER_HOST:
        time.sleep(RATE_LIMIT_PER_HOST - delta)
    _last_hit[host] = time.time()

def iso() -> str:
    return datetime.now(timezone.utc).isoformat()

def sha1(b: bytes) -> str:
    import hashlib; h = hashlib.sha1(); h.update(b); return h.hexdigest()

def load_robots(base_url: str) -> RobotFileParser:
    url = urllib.parse.urljoin(base_url, "/robots.txt")
    rp = RobotFileParser()
    try:
        rp.set_url(url); rp.read()
    except Exception:
        pass
    return rp

def allowed_by_robots(url: str, agent="savant-seeder") -> bool:
    # try to get site root robots
    parts = urllib.parse.urlparse(url)
    root = f"{parts.scheme}://{parts.netloc}/"
    rp = load_robots(root)
    try:
        return rp.can_fetch(agent, url)
    except Exception:
        return True

def html_to_text(content: bytes) -> str:
    soup = BeautifulSoup(content, "html.parser")
    for bad in soup(["script","style","noscript","template"]): bad.decompose()
    text = soup.get_text("\n", strip=True)
    # collapse excessive blank lines
    lines = [ln.strip() for ln in text.splitlines()]
    text = "\n".join([ln for ln in lines if ln])
    return text

def pdf_to_text(content: bytes) -> str:
    try:
        return pdf_extract_text(BytesIO(content))
    except Exception:
        return ""  # gracefully fail

def normalize_text_by_type(ct: str, content: bytes, url: str) -> str:
    ctype = (ct or "").lower()
    if "html" in ctype or url.lower().endswith((".html",".htm",".xhtml",".php",".asp",".aspx",".jsp")):
        return html_to_text(content)
    if "pdf" in ctype or url.lower().endswith(".pdf"):
        return pdf_to_text(content)
    if any(url.lower().endswith(ext) for ext in (".md",".markdown",".txt",".rst",".csv",".json",".yaml",".yml")):
        try:
            return content.decode("utf-8", "ignore")
        except Exception:
            return content.decode("latin-1", "ignore")
    # default to best-effort utf-8
    try:
        t = content.decode("utf-8", "ignore")
    except Exception:
        t = ""
    return t

def fetch_one(url: str) -> Tuple[str, Dict]:
    # returns (raw_text_path or "", meta)
    meta = {
        "time": iso(),
        "url": url,
        "status": "skipped",
        "reason": "",
        "bytes": 0,
        "sha1": "",
        "ctype": "",
        "source_path": "",
        "raw_text_path": ""
    }
    try:
        if not allowed_by_robots(url):
            meta["status"] = "skipped"; meta["reason"] = "robots_disallow"; return "", meta

        rate_limit(url)
        headers = {"User-Agent": "savant-seeder/2.1 (+https://example.local)"}
        with requests.get(url, headers=headers, stream=True, timeout=TIMEOUT) as r:
            if r.status_code != 200:
                meta["status"]="error"; meta["reason"]=f"http_{r.status_code}"; return "", meta
            ctype = r.headers.get("Content-Type","")
            buf = BytesIO()
            size = 0
            for chunk in r.iter_content(1024*32):
                if not chunk: continue
                buf.write(chunk); size += len(chunk)
                if size > MAX_BYTES:
                    meta["status"]="error"; meta["reason"]="too_large"; return "", meta
            content = buf.getvalue()
        h = sha1(content)
        ext = mimetypes.guess_extension(ctype.split(";")[0].strip() or "") or ""
        if not ext:
            if ".pdf" in url.lower(): ext = ".pdf"
            elif ".html" in url.lower() or ".htm" in url.lower(): ext = ".html"
            else: ext = ".bin"
        source_path = SRC / f"{h}{ext}"
        if not source_path.exists():
            source_path.write_bytes(content)
        text = normalize_text_by_type(ctype, content, url)
        if not text.strip():
            meta["status"]="error"; meta["reason"]="empty_text"; return "", meta
        raw_path = RAW / f"{h}.txt"
        if not raw_path.exists():
            raw_path.write_text(text, encoding="utf-8")
        meta.update({"status":"ok","bytes":len(content),"sha1":h,"ctype":ctype,"source_path":str(source_path),"raw_text_path":str(raw_path)})
        return str(raw_path), meta
    except Exception as e:
        meta["status"]="error"; meta["reason"]=str(e)
        return "", meta

def load_seeds() -> List[str]:
    seeds = []
    for p in sorted((SEEDS).glob("*.txt")):
        txt = p.read_text(encoding="utf-8", errors="ignore")
        for line in txt.splitlines():
            line = line.strip()
            if not line or line.startswith("#"): continue
            seeds.append(line)
    return sorted(set(seeds))

def main():
    seeds = load_seeds()
    if not seeds:
        hint = (KDIR / "seeds" / "README.txt")
        hint.write_text(
            "# Put one URL per line here (open-license materials only)\n"
            "# Example OER sources you can add:\n"
            "#   https://web.dev/learn/css/\n"
            "#   https://web.dev/learn/html/\n"
            "#   https://www.freecodecamp.org/news/tag/web-development/\n"
            "#   https://wiki.mozilla.org/Licensing\n"
            "#   https://developer.mozilla.org/en-US/docs/Learn\n"
            "#   https://developer.chrome.com/docs\n"
            "#   https://material.io/design\n"
            "#   https://uxtoast.com (check license)\n", encoding="utf-8"
        )
        print("⚠️  No seed URLs found. Add URLs in ~/savant/knowledge/seeds/*.txt and re-run.")
        return

    print(f"🧭 Curriculum seeder: {len(seeds)} URLs")
    out_meta = META / "ingest.jsonl"
    added = 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_WORKERS) as ex:
        for raw_path, meta in ex.map(fetch_one, seeds):
            added += 1 if raw_path else 0
            with out_meta.open("a", encoding="utf-8") as f:
                f.write(json.dumps(meta, ensure_ascii=False) + "\n")
            status = meta["status"]
            msg = meta["reason"] or meta["ctype"]
            print(f"   • {status:<7} {meta['url']}  {msg}")
    print(f"✅ Seeding complete — new texts: {added}")

if __name__ == "__main__":
    main()
