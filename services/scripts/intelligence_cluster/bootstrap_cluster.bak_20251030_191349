#!/usr/bin/env python3
"""
SAVANT AUTONOMOUS BOOTSTRAP CLUSTER v5.0
----------------------------------------
Boots Savant, verifies connections, performs housekeeping,
and triggers AI, cloud, and GitHub sync automatically.
"""

import os, sys, subprocess, shutil, json, time
from datetime import datetime, timezone, timedelta
from pathlib import Path

BASE = Path.home() / "savant"
LOG = BASE / "logs" / "bootstrap.log"
EXPORT_SCRIPT = BASE / "services" / "scripts" / "intelligence_cluster" / "export_cluster.py"
MIGRATION_SCRIPT = BASE / "services" / "scripts" / "intelligence_cluster" / "migration_check_cluster.py"
KNOWLEDGE_SCRIPT = BASE / "services" / "scripts" / "intelligence_cluster" / "knowledge_synthesis_cluster.py"
GIT_PUSH_SCRIPT = BASE / "services" / "scripts" / "intelligence_cluster" / "github_force_push.py"
CLOUD_UPLINK = BASE / "services" / "scripts" / "cloud_engine" / "cloud_uplink.py"

def log(msg):
    ts = datetime.now(timezone.utc).isoformat()
    line = f"[{ts}] {msg}"
    print(line)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(line + "\n")

def run(cmd, desc):
    log(f"▶ {desc}")
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        log(result.stdout.strip() or "(no output)")
    except subprocess.CalledProcessError as e:
        log(f"⚠ {desc} failed:\n{e.stderr.strip()}")

def clean_temp():
    """Deep clean of temporary folders."""
    log("🧹 Cleaning temporary and cache files...")
    removed = 0
    for pattern in ["*.log", "*.tmp", "__pycache__", ".pytest_cache"]:
        for p in BASE.rglob(pattern):
            try:
                if p.is_file():
                    p.unlink()
                    removed += 1
                elif p.is_dir():
                    shutil.rmtree(p, ignore_errors=True)
                    removed += 1
            except Exception:
                pass
    log(f"✅ Removed {removed} redundant items.")
    return removed

def check_connections():
    """Verify core integrations: OpenAI, GitHub, and S3."""
    log("🔗 Verifying connections...")
    try:
        run(["python3", str(MIGRATION_SCRIPT)], "Check OpenAI + GitHub + S3 connectivity")
    except Exception as e:
        log(f"⚠ Connectivity test failed: {e}")

def run_compaction():
    """Invoke export/compaction cycle."""
    log("📦 Running export + compaction cycle...")
    try:
        run(["python3", str(EXPORT_SCRIPT)], "Run export_cluster.py")
    except Exception as e:
        log(f"⚠ Export failed: {e}")

def sync_github():
    """Force push current state to GitHub."""
    log("🐙 Syncing GitHub repository...")
    try:
        run(["python3", str(GIT_PUSH_SCRIPT)], "GitHub Force Push")
    except Exception as e:
        log(f"⚠ GitHub sync failed: {e}")

def sync_cloud():
    """Upload archives and logs to S3."""
    log("☁️ Uploading archives and logs to cloud...")
    archive_dir = BASE / "archive"
    if not archive_dir.exists():
        log("⚠ No archive directory found, skipping cloud sync.")
        return
    for item in archive_dir.iterdir():
        if item.is_file():
            run(["python3", str(CLOUD_UPLINK), str(item)], f"Upload {item.name}")

def synthesize_knowledge():
    """Rebuild modular AI knowledge shards."""
    log("📚 Running knowledge synthesis cluster...")
    try:
        run(["python3", str(KNOWLEDGE_SCRIPT)], "Knowledge synthesis")
    except Exception as e:
        log(f"⚠ Knowledge synthesis failed: {e}")

def main():
    log(f"🧠 Starting Savant Autonomous Bootstrap Cycle at {datetime.now(timezone.utc).isoformat()}")
    os.chdir(BASE)

    # 1. Cleanup
    clean_temp()

    # 2. Connection checks
    check_connections()

    # 3. Knowledge synthesis
    synthesize_knowledge()

    # 4. Export + compaction
    run_compaction()

    # 5. GitHub + Cloud sync
    sync_github()
    sync_cloud()

    # 6. Completion summary
    log("✅ Bootstrap cycle complete.")
    print("\n✅ Savant Autonomous Bootstrap Cycle finished successfully.")

if __name__ == "__main__":
    main()
