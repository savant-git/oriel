import os, json, time, random
from datetime import datetime
from pathlib import Path

ROOT = Path.home()/ "savant"
LOG = ROOT/"logs/version_map.log"
STATE = ROOT/"logs/version_state.json"

SYMBOLS = {"frontend": "♦", "backend": "⬢", "system": "⬡"}
OPS = ["<", "=", ">"]

def gen_version():
    front, back, sys = [round(random.uniform(1.0, 9.9),1) for _ in range(3)]
    op1, op2 = random.choice(OPS), random.choice(OPS)
    full = f"{SYMBOLS['frontend']}{front}{op1}{SYMBOLS['backend']}{back}{op2}{SYMBOLS['system']}{sys}"
    simple = f"{int(front*10)}{int(back*10)}{int(sys*10)}"
    return full, simple

def process_files():
    date_tag = datetime.utcnow().strftime("%m-%d-%y")
    changes = []
    for path,_,files in os.walk(ROOT):
        if any(skip in path for skip in ("node_modules",".next","__pycache__","dist")): continue
        for f in files:
            if f.endswith(('.py','.ts','.tsx','.js','.mjs','.json')):
                full,simp = gen_version()
                name,ext=os.path.splitext(f)
                if f"_{simp}_" in f: continue
                new=f"{name}_{simp}_{date_tag}{ext}"
                try:
                    os.rename(os.path.join(path,f),os.path.join(path,new))
                    changes.append({"time":datetime.utcnow().isoformat(),"path":str(Path(path)/new),"version_full":full})
                except Exception as e:
                    changes.append({"error":str(e),"file":f})
    if changes:
        LOG.write_text(json.dumps(changes,indent=2))
        STATE.write_text(json.dumps({"updated":datetime.utcnow().isoformat(),"changes":len(changes)},indent=2))
        print(f"🧩 Version update: {len(changes)} files")
    else:
        print("✔️ Versions already current")

if __name__=="__main__":
    while True:
        process_files()
        time.sleep(3600)  # hourly


