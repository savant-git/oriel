import os, json, random, time
from datetime import datetime
from pathlib import Path
from savant.services.scripts.context_engine.context_ledger import add_entry, validate_ledger

ROOT = Path.home()/ "savant"
LOG  = ROOT/"logs/version_updates.log"
VERSIONS = ROOT/"docs/version_registry.json"

LEVELS = ["Vessel","Frame","Filament"]  # top / middle / low levels (auto-selected per app type)
OPS = ["<", "=", ">"]
SAFE = {"<":"_lt_","=":"_eq_",">":"_gt_"}

def utc(): return datetime.utcnow().isoformat()

def generate_version():
    n=[round(random.uniform(1.0,9.9),1) for _ in LEVELS]
    ops=[random.choice(OPS),random.choice(OPS)]
    display=f"🟠{n[0]} {ops[0]} 🟡{n[1]} {ops[1]} 🔴{n[2]}"
    safe=f"{LEVELS[0][0]}{n[0]}{SAFE[ops[0]]}{LEVELS[1][0]}{n[1]}{SAFE[ops[1]]}{LEVELS[2][0]}{n[2]}"
    return display,safe

def versionize_file(path):
    date=datetime.utcnow().strftime("%m-%d-%y")
    full,safe=generate_version()
