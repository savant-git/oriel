def run_versioning():
    ok, issues = validate_ledger()
    if not ok:
        print("⚠️ Context invalid, fix ledger first.")
        return
    updates=[]
    for root,_,files in os.walk(ROOT):
        if any(skip in root for skip in ("node_modules",".next","__pycache__")): continue
        for f in files:
            if f.endswith((".py",".ts",".tsx",".mjs")):
                try:
                    p=Path(root)/f
                    result=versionize_file(p)
                    if result:
                        display,new_name=result
                        updates.append({"file":str(p),"version":display})
                        add_entry("version_engine","update",f"File {new_name} versioned {display}")
                except Exception as e:
                    updates.append({"file":f,"error":str(e)})
    VERSIONS.write_text(json.dumps({"updates":updates,"timestamp":utc()},indent=2))
    print(f"🧩 Version registry updated → {VERSIONS}")

if __name__=="__main__":
