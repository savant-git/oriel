#!/usr/bin/env python3
"""
Savant Version Engine v2.2
───────────────────────────
Triadic Symbol Schema (visual + semantic):

  ⬢  Apex   (core orchestration)   color: #FFB400
  ◆  Medial (integrations)         color: #FFA000
  ⬤  Base   (infrastructure)       color: #FF9500

Operators:
  '>' expanding   '=' balanced   '<' refactoring
"""
import os, re, json, math
from pathlib import Path
from datetime import datetime, timezone

ROOT = Path.home() / "savant"
SCRIPTS = ROOT / "services" / "scripts"
TXT = ROOT / "VERSION"
JSN = ROOT / "VERSION.json"
MAP = ROOT / "version_map.json"
BACKUP_TS = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")

APEX_HINTS  = {"personality_engine","fractal_core","rule_engine","decision_core","governor_core"}
MED_HINTS   = {"ai_core","automation_engine","research_engine","reflex_core","shard_engine","integrity_engine","version_engine"}
BASE_HINTS  = {"utils","web","context_engine","telemetry","federation","realtime","dependency_audit","visual_engine"}

def tier_for(p:Path)->str:
    parts=set(p.parts)
    if parts & APEX_HINTS: return "apex"
    if parts & MED_HINTS: return "medial"
    if parts & BASE_HINTS: return "base"
    depth=len(p.parts)
    return "apex" if depth<=6 else "medial" if depth<=8 else "base"

OVR_DEPTH=re.compile(r"#\s*SVE:DEPTH\s*=\s*(\d+)")
OVR_COMP =re.compile(r"#\s*SVE:COMP\s*=\s*(\d+)")

def overrides(txt:str):
    d=OVR_DEPTH.search(txt); c=OVR_COMP.search(txt)
    return (int(d.group(1)) if d else None, int(c.group(1)) if c else None)

def heuristics(txt:str):
    d=3+int(min(12,(txt.count("def ")+txt.count("class ")+txt.count(" if ")+txt.count(" for ")+txt.count(" while "))/2))
    debt=txt.upper().count("TODO")+txt.upper().count("FIXME")+txt.upper().count("HACK")
    c=5-min(3,debt)+("return" in txt)+("test" in txt)+("success" in txt)
    return max(1,min(15,d)),max(1,min(15,c))

def op_for(d,c): return ">" if d>c else "<" if d<c else "="
def symbol_for(t): return {"apex":"⬢","medial":"◆","base":"⬤"}[t]

def backup(p:Path):
    if p.exists(): p.replace(p.with_suffix(p.suffix+f".bak_{BACKUP_TS}"))

def scan():
    data=[]
    for f in SCRIPTS.rglob("*.py"):
        try:txt=f.read_text()
        except:continue
        tier=tier_for(f.relative_to(ROOT))
        d0,c0=overrides(txt)
        dh,ch=heuristics(txt)
        d=d0 if d0 else dh; c=c0 if c0 else ch
        data.append({"path":str(f.relative_to(ROOT)),"tier":tier,"depth":d,"comp":c,
                     "triad":f"{symbol_for(tier)}{d}{op_for(d,c)}{c}"})
    return {"time":datetime.now(timezone.utc).isoformat(),"entries":data}

def summarize(entries):
    tiers={"apex":[],"medial":[],"base":[]}
    for e in entries: tiers[e["tier"]].append(e)
    def avg(xs,k): return round(sum(x[k] for x in xs)/len(xs),1) if xs else 0
    def tri(xs,sym):
        if not xs:return f"{sym}0=0"
        d,c=int(avg(xs,"depth")),int(avg(xs,"comp"))
        return f"{sym}{d}{op_for(d,c)}{c}"
    apex,med,base=tri(tiers["apex"],"⬢"),tri(tiers["medial"],"◆"),tri(tiers["base"],"⬤")
    ad,ac=int(apex[1:3]),int(apex[-1])
    major=max(1,min(9,math.ceil(ad/2))); minor=max(0,min(9,round((ac+avg(tiers['medial'],'comp')+avg(tiers['base'],'comp'))/3/1.5)))
    meta=f"Savant v{major}.{minor} ({apex} | {med} | {base})"
    return {"meta":meta,"tiers":{"apex":apex,"medial":med,"base":base}}

def write_out(scan,summary):
    backup(TXT); backup(JSN); backup(MAP)
    TXT.write_text(summary["meta"]+"\n",encoding="utf-8")
    JSN.write_text(json.dumps(summary,indent=2),encoding="utf-8")
    MAP.write_text(json.dumps(scan,indent=2),encoding="utf-8")

def main():
    data=scan(); s=summarize(data["entries"]); write_out(data,s); print(s["meta"])

if __name__=="__main__": main()
