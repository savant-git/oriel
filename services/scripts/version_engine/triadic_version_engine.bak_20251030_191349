                sig["hash"]=compute_hash(path)
                manifest[path.replace(ROOT,"")]=sig
    with open(MANIFEST,"w") as f: json.dump(manifest,f,indent=2)
    print(f"✅ Triadic manifest written → {MANIFEST}")


