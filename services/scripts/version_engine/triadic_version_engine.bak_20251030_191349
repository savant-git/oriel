import os, json, datetime, random, hashlib

ROOT = "/data/data/com.termux/files/home/savant"
MANIFEST = os.path.join(ROOT, "docs", "version_manifest.json")

symbols = {"frontend":"♦","backend":"⬣","intelligence":"⬡"}
relations = ["=",">","<"]

def generate_digit_pair():
    a,b = random.randint(1,9), random.randint(1,9)
    return a,b,random.choice(relations)

def generate_triadic_signature(entity:str):
    f1,f2,fr = generate_digit_pair()
    b1,b2,br = generate_digit_pair()
    i1,i2,ir = generate_digit_pair()
    full=f"({symbols['frontend']}{f1}{fr}{f2} | {symbols['backend']}{b1}{br}{b2} | {symbols['intelligence']}{i1}{ir}{i2})"
    compact=f"♦{f1}{fr}{f2}_⬣{b1}{br}{b2}_⬡{i1}{ir}{i2}"
    meaning={
        "frontend":f"UI responsiveness {f1} {fr} {f2}",
        "backend":f"System logic {b1} {br} {b2}",
        "intelligence":f"AI cognition {i1} {ir} {i2}",
    }
    return {"entity":entity,"full":full,"compact":compact,"meaning":meaning,
            "timestamp":datetime.datetime.utcnow().isoformat()}

def compute_hash(path:str):
    if not os.path.exists(path): return "N/A"
    with open(path,"rb") as f: content=f.read()
    return hashlib.sha1(content).hexdigest()[:10]

