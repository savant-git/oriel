"""
SAVANT CONTINUITY ENGINE (Phase 13)
Stores conversation embeddings for cross-session context memory.
"""
from openai import OpenAI
from pathlib import Path
import orjson as json, numpy as np, os
from pydantic_settings import BaseSettings

ROOT=Path.home()/ "savant"/"memory"
ROOT.mkdir(parents=True,exist_ok=True)
load_dotenv(Path.home() / "savant" / ".env")/".env")
client=OpenAI(api_key=os.getenv("OPENAI_API_KEY"))

def embed(text:str):
    e=client.embeddings.create(model="text-embedding-3-small",input=text)
    return np.array(e.data[0].embedding)

def store(ref,text):
    vec=embed(text).tolist()
    data={"ref":ref,"text":text,"embedding":vec}
    (ROOT/f"{ref}.json").write_text(json.dumps(data))

def recall(query):
    q=embed(query)
    best=None;score=-1
    for f in ROOT.glob("*.json"):
        d=json.loads(f.read_text())
        v=np.array(d["embedding"])
        sim=float(np.dot(q,v)/(np.linalg.norm(q)*np.linalg.norm(v)))
        if sim>score:score,best=sim,d
    return best["text"] if best else "No related context."


