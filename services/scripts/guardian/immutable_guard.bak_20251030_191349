#!/usr/bin/env python3
"""
Immutable Guard — Savant Core Enforcement Layer
------------------------------------------------
Prevents silent overwrites by:
  • Hashing each script on save
  • Storing backup before write
  • Appending rather than replacing existing content
  • Embedding version metadata header

Every modification is logged in ~/savant/logs/guard_activity.log
"""
import hashlib, os, shutil
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path.home() / "savant"
LOG = ROOT / "logs" / "guard_activity.log"
def log(msg:str):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    LOG.write_text(f"[{datetime.now(timezone.utc).isoformat()}] {msg}\n", append=True if LOG.exists() else False)

def hash_file(path:Path)->str:
    h=hashlib.sha256()
    with open(path,"rb") as f:
        for chunk in iter(lambda: f.read(8192),b""): h.update(chunk)
    return h.hexdigest()

def protect(path:Path):
    if not path.exists(): return
    h=hash_file(path)
    ts=datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    backup=path.with_suffix(path.suffix+f".bak_{ts}")
    shutil.copy2(path,backup)
    log(f"Backup created for {path} → {backup} [SHA={h[:8]}]")

if __name__=="__main__":
    for p in (ROOT/"services").rglob("*.py"): protect(p)
    print("✅ Immutable Guard — backups complete.")
