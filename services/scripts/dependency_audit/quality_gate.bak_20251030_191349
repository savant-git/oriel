import json, subprocess, sys

MIN_STARS = 5000
DISALLOWED = ["react", "vite", "tailwindcss", "redux", "next"]

def get_repo_stars(package):
    try:
        url = subprocess.check_output(
            ["npm", "view", package, "repository.url"], text=True
        ).strip().replace("git+", "").replace(".git", "")
        if "github.com" in url:
            owner_repo = url.split("github.com/")[1]
            api = f"https://api.github.com/repos/{owner_repo}"
            import requests
            data = requests.get(api).json()
            return data.get("stargazers_count", 0)
        return 0
    except Exception:
        return 0

def audit():
    deps = json.loads(subprocess.check_output(["npm", "ls", "--json"], text=True))["dependencies"]
    failed = []
    for pkg in deps:
        if any(bad in pkg for bad in DISALLOWED):
            failed.append(f"{pkg} (banned)")
        stars = get_repo_stars(pkg)
        if stars < MIN_STARS:
            failed.append(f"{pkg} ({stars}★ < {MIN_STARS}★ required)")
    if failed:
        print("❌ Failed quality gate:")
        print("\n".join(f" - {f}" for f in failed))
        sys.exit(1)
    print("✅ All dependencies meet Savant quality threshold.")

if __name__ == "__main__":
    audit()


