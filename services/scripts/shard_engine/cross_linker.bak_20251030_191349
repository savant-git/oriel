#!/usr/bin/env python3
"""
Phase 23 – Cross-Project Shard Linker
Links identical shards across different projects to keep them synchronized.
"""
import orjson as json, hashlib
from pathlib import Path

ROOT=Path.home()/ "savant"
LIBS=list(ROOT.glob("**/shard_library.json"))
MASTER=ROOT/"savant_master_shards.json"

def merge():
    merged={}
    for lib in LIBS:
        data=json.loads(lib.read_text())
        for s in data:
            merged[s["id"]]=s
    MASTER.write_text(json.dumps(list(merged.values()),indent=2))
    print(f"🔗 Linked shards across {len(LIBS)} libraries → {MASTER}")

if __name__=="__main__": merge()


