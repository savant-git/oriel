#!/usr/bin/env python3
"""
Phase 21 – Live Shard Indexer
Continuously watches for file changes and updates shard_library.json in real time.
"""
from watchdog.observers import Observer
from watchdog.events import FileSystemEventHandler
from pathlib import Path
import pendulum as time, json, hashlib

SRC=Path.home()/ "savant"/"services"/"scripts"
LIB=Path.home()/ "savant"/"services"/"scripts"/"shard_engine"/"shard_library.json"

def sha1(t): return hashlib.sha1(t.encode()).hexdigest()[:10]

class ShardWatcher(FileSystemEventHandler):
    def on_modified(self, e):
        if not e.src_path.endswith((".py",".ts",".tsx",".js")): return
        p=Path(e.src_path); code=p.read_text(errors="ignore")
        h=sha1(code)
        try: lib=json.loads(LIB.read_text())
        except: lib=[]
        entry={"id":h,"path":str(p),"lines":len(code.splitlines())}
        lib=[x for x in lib if x["path"]!=str(p)]
        lib.append(entry)
        LIB.write_text(json.dumps(lib,indent=2))
        print(f"🔄 Updated shard index for {p.name}")

if __name__=="__main__":
    obs=Observer(); w=ShardWatcher()
    obs.schedule(w,str(SRC),recursive=True); obs.start()
    print("👁️  Live Shard Indexer active...")
    try:
        while True: time.sleep(1)
    except KeyboardInterrupt: obs.stop()
    obs.join()


