#!/usr/bin/env python3
"""
Phase 25 – Shard Mutation Engine
Creates small variations of shards for experimentation.
"""
import orjson as json, random
from pathlib import Path
LIB=Path.home()/ "savant"/"services"/"scripts"/"shard_engine"/"shard_library.json"
MUT=LIB.parent/"mutations.json"

def mutate():
    data=json.loads(LIB.read_text())
    variants=[]
    for s in random.sample(data,min(5,len(data))):
        altered=s["content"].replace("def ","def m_")
        s2=s.copy(); s2["content"]=altered; s2["id"]=s["id"]+"_m"
        variants.append(s2)
    MUT.write_text(json.dumps(variants,indent=2))
    print(f"🧬 Generated {len(variants)} mutations → {MUT}")

if __name__=="__main__": mutate()


