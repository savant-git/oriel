from pathlib import Path
import hashlib, json, re, os, datetime

ROOT = Path.home() / "savant"
SRC  = ROOT / "services" / "scripts"
OUT  = ROOT / "services" / "scripts" / "shard_engine"
LIB  = OUT / "shard_library.json"
LEDGER = ROOT / "logs" / "context_ledger.log"

COLOR = {
    "gunmetal":"#1e1e21",
    "gold":"#c7a740",
    "red":"#ff3838"
}

def sha1(data:str)->str:
    return hashlib.sha1(data.encode("utf8")).hexdigest()[:10]

def timestamp()->str:
    return datetime.datetime.now(datetime.UTC).isoformat()

# 🔸 BEGIN_SNIPPET snippet_8 [8d70aa8922]
<span style='color:#c7a740'>enhance_path(path: Path, recursive: bool):
    if path.is_file():
        targets = [path]
    else:
        targets = scan_elements(path, recursive)
