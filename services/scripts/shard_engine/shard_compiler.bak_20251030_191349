# 🔸 END_SNIPPET
def colorize(code:str)->str:
    """Wraps snippet in inline HTML span for branded syntax highlighting."""
    return f"<span style='color:{COLOR['gold']}'>{code}</span>"

def extract_snippets(text:str, file:str)->list:
    """Find top-level defs, classes, or component blocks as shards."""
    pattern = r"(?m)^(def |class |export default |function |const |let |import |<\w+)"
    parts = re.split(pattern, text)
    shards=[]
    for i,p in enumerate(parts):
        c=p.strip()
        if len(c)<20: continue
        h=sha1(c)
        shards.append({
            "id":h,
            "name":f"snippet_{i}",
            "source":file,
            "length":len(c.splitlines()),
            "content":c,
            "timestamp":timestamp()
        })
    return shards

def build_library():
    library=[]
    for path in SRC.rglob("*.*"):
        if path.suffix.lower() not in [".py",".ts",".tsx",".js",".css",".html",".md"]: continue
        code=path.read_text(errors="ignore")
        snips=extract_snippets(code,str(path))
        library+=snips
    LIB.write_text(json.dumps(library,indent=2))
    print(f"📘 Library built → {LIB} ({len(library)} shards)")

def insert_instances():
    library=json.loads(LIB.read_text())
    used=0
    for path in SRC.rglob("*.*"):
        if path.suffix.lower() not in [".py",".ts",".tsx",".js"]: continue
        text=path.read_text(errors="ignore")
        lines=text.splitlines()
        if len(lines)<50: continue
        seg="\n".join(lines[:30])
        snip=library[used % len(library)]
        mark_start=f"# 🔸 BEGIN_SNIPPET {snip['name']} [{snip['id']}]"
        mark_end  ="# 🔸 END_SNIPPET"
        new_text=f"{seg}\n{mark_start}\n{colorize(snip['content'])}\n{mark_end}\n"+"\n".join(lines[30:])
        path.write_text(new_text)
        used+=1
    print(f"🧩 Inserted {used} shard instances.")

def log_entry(action:str,detail:str):
    LEDGER.parent.mkdir(parents=True,exist_ok=True)
    with LEDGER.open("a") as f:
        f.write(json.dumps({
            "timestamp":timestamp(),
            "action":action,
            "detail":detail,
            "path":"shard_engine/shard_compiler.py"
        })+"\n")

def main():
    print("🔧 Building atomic shard library...")
    build_library()
    print("🧩 Inserting shard instances into eligible scripts...")
    insert_instances()
    log_entry("build_shard_library","atomic decomposition + instance insertion complete")
    print("✅ Savant Shard Compiler finished.")

if __name__=="__main__":
    main()

