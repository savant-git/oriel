import os, re
from datetime import datetime, timezone
from savant.services.event_bus.event_bus_core import publish

class EnhancementEngine:
    """Auto-completes, cleans, and enhances Savant scripts."""
    def enhance(self, target):
        paths = []
        if os.path.isdir(target):
            for root, _, files in os.walk(target):
                for f in files:
                    if f.endswith(".py"):
                        paths.append(os.path.join(root, f))
        elif os.path.isfile(target):
            paths = [target]
        else:
            print(f"⚠ No valid file or directory: {target}")
            return []

        modified = []
        for path in paths:
            try:
                text = open(path).read()
                if "TODO" in text or re.search(r"\bpass\b", text):
                    text = re.sub(r'\bpass\b', '# Enhanced completion placeholder\n', text)
                    with open(path, "w") as f:
                        f.write(text)
                    modified.append(path)
            except Exception as e:
                print(f"⚠ Failed to enhance {path}: {e}")

        publish("enhancement_done", {
            "targets": modified,
            "timestamp": datetime.now(timezone.utc).isoformat()
        })
        print("✅ Enhancement complete.")
        return modified


