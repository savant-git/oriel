import os, json, time
from datetime import datetime
from pathlib import Path

ROOT = Path.home()/ "savant"
TASK_FILE = ROOT/"downloads/savant_tasks.json"

def collect_elements(root):
    tasks=[]
    for path,_,files in os.walk(root):
        for f in files:
            if f.endswith(('.py','.tsx','.js')): 
                rel=str(Path(path)/f)
                tasks.append({"path":rel,"priority":"medium","status":"pending"})
    return tasks

def save_tasks(data):
    TASK_FILE.write_text(json.dumps(data,indent=2))
    print(f"🧭 Saved {len(data)} tasks → {TASK_FILE}")

if __name__=="__main__":
    all_tasks=collect_elements(str(ROOT/"services"))
    save_tasks(all_tasks)


