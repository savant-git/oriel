#!/usr/bin/env python3
"""
SAVANT FRACTAL VISUALIZATION ENGINE (Phase 6.0)
Interactive 3D visualizer for fractal_core hierarchy using Plotly 3D.
Outputs both HTML and JSON views for integration with wb_ui dashboard.
"""

import orjson as json, math
from pathlib import Path
import plotly.graph_objects as go
from datetime import datetime, timezone

ROOT = Path.home()/ "savant"
DATA = ROOT/"services"/"scripts"/"fractal_core"/"fractal_graph.json"
OUT  = ROOT/"services"/"scripts"/"fractal_visualization"/"fractal_scene.html"

def utc(): return datetime.now(timezone.utc).isoformat()

def flatten(node, depth=0, parent=None):
    nodes=[]
    nodes.append({"id":node["id"],"name":node["name"],"curv":node["curvature"],"depth":depth,"parent":parent})
    for c in node.get("children",[]): nodes+=flatten(c,depth+1,node["id"])
    return nodes

def visualize():
    data=json.loads(DATA.read_text())
    nodes=flatten(data)
    xs=[math.cos(n["depth"])*n["curv"]*2 for n in nodes]
    ys=[math.sin(n["depth"])*n["curv"]*2 for n in nodes]
    zs=[n["depth"]*1.2 for n in nodes]
    text=[n["name"] for n in nodes]

    fig=go.Figure(data=[go.Scatter3d(
        x=xs,y=ys,z=zs,mode="markers+text",text=text,textposition="top center",
        marker=dict(size=8,color=[n["curv"] for n in nodes],
                    colorscale="YlOrBr",opacity=0.9)
    )])
    fig.update_layout(scene=dict(bgcolor="#0e0e10"),
                      paper_bgcolor="#0e0e10",
                      font=dict(color="#e4c66f"),
                      title="Savant Fractal Hierarchy")
    OUT.write_text(fig.to_html(full_html=True,include_plotlyjs="cdn"))
    print(f"✅ Fractal scene exported → {OUT}")

if __name__=="__main__":
    visualize()


