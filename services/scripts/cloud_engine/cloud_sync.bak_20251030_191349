import os
import json
import boto3
from dotenv import load_dotenv
from datetime import datetime
import pathlib

# Load environment variables from the .env file
load_dotenv(os.path.expanduser("~/savant/.env"))

# Retrieve AWS S3 configuration from environment variables
S3_BUCKET = os.getenv("S3_BUCKET")
AWS_ACCESS_KEY_ID = os.getenv("AWS_ACCESS_KEY_ID")
AWS_SECRET_ACCESS_KEY = os.getenv("AWS_SECRET_ACCESS_KEY")

def sync_to_cloud(local_dir="~/savant/knowledge"):
    """
    Sync files from a local directory to an S3 bucket.

    Args:
        local_dir (str): The local directory to sync. Default is '~/savant/knowledge'.

    Returns:
        int: The number of files uploaded to the S3 bucket.
    """
    # Expand user directory and create a Path object
    local = pathlib.Path(os.path.expanduser(local_dir))
    
    # Initialize the S3 client with AWS credentials
    s3 = boto3.client(
        "s3",
        aws_access_key_id=AWS_ACCESS_KEY_ID,
        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
    )
    
    uploaded = 0  # Counter for uploaded files

    # Iterate through all files in the local directory recursively
    for fp in local.rglob("*"):
        if fp.is_file():  # Check if the path is a file
            key = f"savant/{fp.relative_to(local)}"  # Create the S3 key
            try:
                # Upload the file to S3
                s3.upload_file(str(fp), S3_BUCKET, key)
                uploaded += 1  # Increment the uploaded files counter
            except Exception as e:
                print(f"Error uploading {fp}: {e}")  # Log any errors that occur

    # Print the total number of uploaded files
    print(f"☁️  Synced {uploaded} files to s3://{S3_BUCKET}/savant/")
    return uploaded

if __name__ == "__main__":
    # Execute the sync function when the script is run directly
    sync_to_cloud()
