#!/usr/bin/env python3
"""
Savant AI Core Gateway v4.2 — Universal Lifespan + Auto-Serve
--------------------------------------------------------------
• Works across all FastAPI versions
• Launches automatically on execution
• Writes structured logs + ledger entries
"""

import os, sys, json, datetime, asyncio, httpx, orjson
from pathlib import Path
from fastapi import FastAPI, Request
from fastapi.responses import StreamingResponse, JSONResponse
from contextlib import asynccontextmanager
from dotenv import load_dotenv
from loguru import logger
import uvicorn

BASE = Path.home() / "savant"
load_dotenv(BASE / ".env")

OPENAI_KEY  = os.getenv("OPENAI_API_KEY")
OPENAI_ORG  = os.getenv("OPENAI_ORG", "")
if not OPENAI_KEY:
    print("❌ Missing OPENAI_API_KEY in .env")
    sys.exit(1)

LOG_PATH = BASE / "logs" / "ai_gateway.log"
LEDGER   = BASE / "context" / "context_ledger.json"
LOG_PATH.parent.mkdir(parents=True, exist_ok=True)

def append_ledger(entry: dict):
    try:
        if not LEDGER.exists():
            LEDGER.write_text("[]")
        data = json.loads(LEDGER.read_text())
        data.append(entry)
        LEDGER.write_text(orjson.dumps(data, option=orjson.OPT_INDENT_2).decode())
    except Exception as e:
        logger.error(f"Ledger write failed: {e}")

async def stream_openai(prompt: str):
    url = "https://api.openai.com/v1/chat/completions"
    headers = {
        "Authorization": f"Bearer {OPENAI_KEY}",
        "Content-Type": "application/json",
        "OpenAI-Organization": OPENAI_ORG or None,
    }
    payload = {
        "model": "gpt-4o-mini",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.8,
        "stream": True,
    }
    async with httpx.AsyncClient(timeout=120) as client:
        async with client.stream("POST", url, headers=headers, json=payload) as resp:
            async for chunk in resp.aiter_text():
                yield chunk

# ----------------------------------------------------------
# LIFESPAN HANDLER (Universal Compatibility)
# ----------------------------------------------------------
@asynccontextmanager
async def lifespan(app: FastAPI):
    logger.add(LOG_PATH, rotation="1 MB")
    logger.info("🚀 Savant AI Core Gateway v4.2 started.")
    yield
    logger.info("🛑 Gateway shutting down gracefully.")

app = FastAPI(title="Savant AI Gateway", version="4.2", lifespan=lifespan)

@app.post("/api/ai")
async def ai_endpoint(req: Request):
    data = await req.json()
    prompt = data.get("prompt", "")
    if not prompt:
        return JSONResponse({"error": "Missing prompt."}, status_code=400)

    t0 = datetime.datetime.utcnow().isoformat()
    append_ledger({"timestamp": t0, "prompt": prompt, "status": "sent"})
    logger.info(f"Prompt received: {prompt[:60]}...")

    try:
        return StreamingResponse(stream_openai(prompt), media_type="text/event-stream")
    except Exception as e:
        append_ledger({"timestamp": t0, "prompt": prompt, "error": str(e)})
        return JSONResponse({"error": str(e)}, status_code=500)

@app.get("/api/version")
async def version():
    return {"savant_version": "♦12>9 | ⬣11=7 | ⬡10<6", "semantic": "4.2.0"}

if __name__ == "__main__":
    uvicorn.run("savant.services.scripts.ai_core.openai_gateway:app",
                host="0.0.0.0", port=8000, reload=False, access_log=False)


