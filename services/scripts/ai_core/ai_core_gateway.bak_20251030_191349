#!/usr/bin/env python3
"""
Savant AI Core Gateway v3.5
• Fixes 404 by reverting to root /v1 endpoint
• Automatically detects project vs legacy keys
• Simplified header logic for project-scoped keys
"""
import os, json, time, requests
from pathlib import Path
from pydantic_settings import BaseSettings

ROOT = Path.home()/"savant"
ENV_PATH = ROOT/".env"
CONTEXT = ROOT/"services"/"scripts"/"context_engine"/"context_ledger.json"
RULES = ROOT/"docs"/"PROJECT_RULES.md"
LOGS  = ROOT/"logs"/"ai_gateway.log"

load_dotenv(ENV_PATH)
API_KEY  = os.getenv("OPENAI_API_KEY","").strip()
ORG_ID   = os.getenv("OPENAI_ORGANIZATION_ID")
MODEL    = os.getenv("SAVANT_AI_MODEL","gpt-4o-mini")

if not API_KEY:
    raise RuntimeError("❌ No OPENAI_API_KEY found in ~/savant/.env")

# --- Detect key type ------------------------------------------
IS_PROJECT_KEY = API_KEY.startswith("sk-proj-")
BASE_URL = "https://api.openai.com/v1/chat/completions"

HEADERS = {
    "Content-Type": "application/json",
    "Authorization": f"Bearer {API_KEY}"
}
if ORG_ID and not IS_PROJECT_KEY:
    HEADERS["OpenAI-Organization"] = ORG_ID

# --- Helpers --------------------------------------------------
def utc(): return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

def load_context():
    if CONTEXT.exists():
        try: return "\n".join(CONTEXT.read_text().splitlines()[-20:])
        except Exception as e: return f"[context error: {e}]"
    return "[no context entries]"

def enforce_rules():
    if not RULES.exists(): raise RuntimeError("🚫 Missing PROJECT_RULES.md")
    if time.time() - RULES.stat().st_mtime > 86400:
        raise RuntimeError("🚫 Rules outdated (>24h); run rule collector.")

def ai_chat(prompt:str):
    enforce_rules()
    context = load_context()
    payload = {
        "model": MODEL,
        "messages": [
            {"role":"system","content":"You are Savant — lucid, formal, subtly poetic."},
            {"role":"user","content":f"Context:\n{context}\n\nPrompt:\n{prompt}"}
        ],
        "temperature":0.35
    }
    try:
        res = requests.post(BASE_URL, headers=HEADERS, json=payload, timeout=60)
        if res.status_code != 200:
            raise RuntimeError(f"{res.status_code} {res.text}")
        msg = res.json()["choices"][0]["message"]["content"]
        LOGS.parent.mkdir(parents=True,exist_ok=True)
        with open(LOGS,"a") as f:
            f.write(json.dumps({"timestamp":utc(),"prompt":prompt,"response":msg},indent=2)+"\n")
        print(f"\n🧠 SAVANT RESPONSE\n{'-'*60}\n{msg}\n")
        return msg
    except Exception as e:
        print(f"⚠️  AI request failed: {e}")
        return "[AI fallback]"

if __name__=="__main__":
    print("🔮 Savant AI Core Gateway v3.5 active (final auth model).")
    print(f"🔑 Key type: {'Project' if IS_PROJECT_KEY else 'Legacy'}")
    while True:
        try:
            q=input("🗯  Enter prompt: ")
            if q.strip().lower() in ["exit","quit"]: break
            ai_chat(q)
        except KeyboardInterrupt:
            break


