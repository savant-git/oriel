#!/usr/bin/env python3
"""
SAVANT FRACTAL ARCHIVE (Phase 15)
Creates time-versioned snapshots of fractal states and allows replay as 3-D animation.
"""
import orjson as json, time
from pathlib import Path

SRC=Path.home()/ "savant"/"services"/"scripts"/"fractal_core"/"fractal_graph.json"
ARC=Path.home()/ "savant"/"archives"
ARC.mkdir(exist_ok=True)

def snapshot():
    if not SRC.exists(): return
    data=json.loads(SRC.read_text())
    stamp=time.strftime("%Y%m%d_%H%M%S")
    (ARC/f"fractal_{stamp}.json").write_text(json.dumps(data,indent=2))
    print(f"📦 Snapshot saved → {ARC/f'fractal_{stamp}.json'}")

def replay():
    files=sorted(ARC.glob("fractal_*.json"))
    for f in files:
        print(f"⏪ {f.name}")
        time.sleep(0.5)


