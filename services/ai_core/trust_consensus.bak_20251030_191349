import json, os, numpy as np
from datetime import datetime, timezone
from savant.services.ai_core.quantum_graph_engine import QuantumGraphEngine
BASE = os.path.expanduser("~/savant/context")
TRUST_PATH = os.path.join(BASE,"trust_matrix.json")

def now(): return datetime.now(timezone.utc).isoformat()

def compute_trust():
    eng = QuantumGraphEngine()
    n = eng.G.number_of_nodes()
    if n==0:
        return {"nodes":0,"mean_trust":1.0,"timestamp":now()}
    trust = []
    for node,data in eng.G.nodes(data=True):
        conf = data.get("confidence",0.5)
        rels = [eng.G[u][v]["weight"] for u,v in eng.G.edges(node)]
        t = np.mean(rels) * conf if rels else conf
        trust.append(t)
        eng.G.nodes[node]["trust"]=float(t)
    mean = float(np.mean(trust))
    json.dump({"mean_trust":mean,"nodes":n,"timestamp":now()}, open(TRUST_PATH,"w"))
    eng.save()
    return {"nodes":n,"mean_trust":mean,"timestamp":now()}
