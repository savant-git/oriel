@app.get("/api/ledger")
async def ledger_summary():
    ctx_file = CONTEXT / "context_ledger.json"
    if ctx_file.exists():
        try:
            return json.loads(ctx_file.read_text())
        except Exception:
            return {"error": "Corrupt ledger"}
    return {"error": "Ledger missing"}

# --- JWT helper ------------------------------------------------
@app.post("/api/token")
async def issue_token():
    payload = {"iat": datetime.now(timezone.utc).timestamp(), "role": "dev"}
    token = jwt.encode(payload, KEY, algorithm="HS256")
    return {"token": token}

