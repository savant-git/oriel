from fastapi import FastAPI, Request, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from datetime import datetime, timezone
import json, random, pathlib, os
from jose import jwt

BASE = pathlib.Path.home() / "savant"
CONTEXT = BASE / "context"
LOGS = BASE / "logs"
KEY = "savant_dev_key"

app = FastAPI(title="Savant Command Center", version="7.2")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"], allow_methods=["*"], allow_headers=["*"]
)

# --- System telemetry -----------------------------------------
@app.get("/api/system")
async def system_stats():
    try:
        import psutil
        cpu = psutil.cpu_percent()
        mem = psutil.virtual_memory().percent
        disk = psutil.disk_usage("/").percent
    except Exception:
        cpu, mem, disk = [round(random.uniform(10,70),1) for _ in range(3)]
    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "cpu": cpu, "mem": mem, "disk": disk,
        "status": "ok"
    }

# --- Fractal map (shard relationships) -------------------------
@app.get("/api/fractal")
async def fractal_map():
    shards = []
    for root, dirs, files in os.walk(BASE / "services/scripts"):
        for f in files:
            shards.append({"id": f, "path": str(pathlib.Path(root)/f)})
    nodes = [{"id": s["id"], "group": random.randint(1,5)} for s in shards]
    links = [{"source": random.choice(nodes)["id"],
              "target": random.choice(nodes)["id"]} for _ in range(min(len(nodes),40))]
    return {"nodes": nodes, "links": links}

# --- AI core proxy ---------------------------------------------
@app.post("/api/ai")
async def ai_proxy(req: Request):
    """Forward prompt to local or remote OpenAI gateway if available."""
    body = await req.json()
    prompt = body.get("prompt")
    if not prompt:
        raise HTTPException(status_code=400, detail="Missing prompt")
    try:
        from openai import OpenAI
        import os
        client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))
        chat = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[{"role":"user","content":prompt}]
        )
        return {"response": chat.choices[0].message.content}
    except Exception as e:
        return {"error": str(e), "response":
            f"(offline) Received prompt: {prompt[:60]}..."}

