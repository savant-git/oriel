FED_PATH = Path.home() / "savant/context/federation_peers.json"

@app.post("/api/federation/register", tags=["Federation"])
async def federation_register(peer:dict):
    FED_PATH.parent.mkdir(parents=True, exist_ok=True)
    peers = []
    if FED_PATH.exists():
        peers = json.loads(FED_PATH.read_text()).get("peers", [])
    if peer["url"] not in peers:
        peers.append(peer["url"])
    FED_PATH.write_text(json.dumps({"peers":peers}, indent=2))
    return {"status":"registered","peers":peers}

@app.get("/api/federation/peers", tags=["Federation"])
async def federation_peers():
    if FED_PATH.exists():
        return json.loads(FED_PATH.read_text())
    return {"peers":[]}

