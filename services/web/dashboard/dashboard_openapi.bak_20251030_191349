import boto3
from botocore.exceptions import BotoCoreError, NoCredentialsError

@app.post("/api/cloud/sync", tags=["Cloud"])
async def cloud_sync_post():
    """Perform a cloud sync of context + research data to S3."""
    bucket = os.getenv("SAVANT_S3_BUCKET", "savant-context")
    key_prefix = os.getenv("SAVANT_S3_PREFIX", "context/")
    creds_path = os.path.expanduser("~/.savant/s3_credentials.json")

    if not os.path.exists(creds_path):
        return {"error": "S3 credentials missing", "path": str(creds_path)}

    creds = json.load(open(creds_path))
    try:
        s3 = boto3.client(
            "s3",
            aws_access_key_id=creds["access_key"],
            aws_secret_access_key=creds["secret_key"]
        )
        uploaded = []
        base_dir = os.path.expanduser("~/savant/context")
        for root, _, files in os.walk(base_dir):
            for f in files:
                fp = os.path.join(root, f)
                key = key_prefix + f
                s3.upload_file(fp, bucket, key)
                uploaded.append(f)
        return {"timestamp": datetime.now().isoformat(),
                "uploaded": len(uploaded),
                "bucket": bucket}
    except (BotoCoreError, NoCredentialsError) as e:
        return {"error": str(e), "bucket": bucket}

