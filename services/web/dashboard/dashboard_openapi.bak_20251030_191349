@app.post("/api/ai", tags=["AI"])
async def ai_proxy(req: Request):
    """Forward prompts to OpenAI or return offline response."""
    body = await req.json()
    prompt = body.get("prompt")
    if not prompt:
        raise HTTPException(status_code=400, detail="Missing prompt")
    try:
        from openai import OpenAI
        client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))
        chat = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[{"role": "user", "content": prompt}]
        )
        return {"response": chat.choices[0].message.content}
    except Exception as e:
        return {"error": str(e), "response": f"(offline) Received prompt: {prompt[:60]}..."}

