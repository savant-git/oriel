# === UTILITY FUNCTIONS ===
def clean_text(t):
    t = re.sub(r"\\[A-Za-z]+[0-9]*", "", t)
    t = t.replace("{","").replace("}","").replace("\r","\n")
    t = re.sub(r"\n{2,}", "\n\n", t)
    return t.strip()

def tokenize(t):
    return [w.lower() for w in re.findall(r"[A-Za-z0-9']+", t) if w.lower() not in STOPWORDS]

def cosine(a, b):
    inter = set(a)&set(b)
    num = sum(a[t]*b[t] for t in inter)
    den = math.sqrt(sum(v*v for v in a.values())) * math.sqrt(sum(v*v for v in b.values()))
    return num/den if den else 0

# === ADVANCED SCORING ===
def score_paragraph(p, ctx):
    tokens = tokenize(p)
    freq = Counter(tokens)
    scores = {}
    for name, data in ctx.items():
        kw_score = sum(freq[k] for k in data["keywords"] if k in freq)
        sum_freq = Counter(tokenize(data["summary"]))
        sim = cosine(freq, sum_freq)
        token_entropy = len(set(tokens)) / (len(tokens)+1)
        hybrid = (kw_score*0.5) + (sim*0.4) + (token_entropy*0.1)
        scores[name] = hybrid
    return scores

# === CLASSIFICATION ===
def classify_text(text):
    paragraphs = re.split(r'(?:\n{2,}|(?<=[.!?])\s+(?=[A-Z]))', text)
    paragraphs = [p.strip() for p in paragraphs if len(p.strip())>20]
    results = defaultdict(list)
    log_entries = []
    for p in paragraphs:
        s = score_paragraph(p, CONTEXT)
        best = max(s, key=s.get)
        confidence = s[best]
        if confidence < 0.2:
            best = "unclassified_data"
        results[best].append(p)
        log_entries.append({"paragraph": p[:80]+"...", "scores": s})
    with open(os.path.join(MANIFEST,"audit.log"),"w",encoding="utf-8") as f:
        json.dump(log_entries,f,indent=2)
    return results

# === SPLITTING ===
def split_entries(name, paragraphs):
    dst = os.path.join(REFINED, name)
    os.makedirs(dst, exist_ok=True)
    chunk = max(1, len(paragraphs)//PARTS)
    for i in range(PARTS):
        frag = paragraphs[i*chunk:(i+1)*chunk]
        if not frag: continue
        frag_path = os.path.join(dst, f"{str(i+1).zfill(2)}.html")
        with open(frag_path,"w",encoding="utf-8") as f:
            f.write("<html><body><pre>"+ "\n\n".join(frag)+"</pre></body></html>")

# === PIPELINE ===
def process_all():
    if not os.path.exists(SOURCE_FILE):
        print(f"!error: source not found {SOURCE_FILE}")
        return
    raw = open(SOURCE_FILE,"r",encoding="utf-8",errors="ignore").read()
    text = clean_text(raw)
    classified = classify_text(text)

    print("Diagnostic paragraph counts:")
    for k,v in classified.items():
        print(f" {k}: {len(v)} paragraphs")

    for name, paras in classified.items():
        split_file = os.path.join(SPLIT, f"{name}.html")
        os.makedirs(SPLIT, exist_ok=True)
        with open(split_file,"w",encoding="utf-8") as f:
            f.write(f"<html><body><h1>{name}</h1><pre>\n")
            f.write("\n\n".join(paras))
            f.write("</pre></body></html>")
        split_entries(name, paras)
        print(f"[ok] {name}: written and segmented into 20 parts")

    print("\n[summary] enhanced contextual classification complete.")

# === ENTRYPOINT ===
if __name__ == "__main__":
    process_all()


