def ai_reflect(context="Reflex Cycle Summary"):
    payload = {"prompt": f"Analyze latest ReflexDaemon cycles and summarize insights for {context}."}
    try:
        r = requests.post(AI_URL, json=payload, timeout=60)
        data = r.json()
        log(f"🧠 AI reflection: {json.dumps(data)[:400]}...")
        return data
    except Exception as e:
        log(f"⚠️ AI reflection failed: {e}")
        return {"error": str(e)}

