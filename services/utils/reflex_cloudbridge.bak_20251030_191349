import os, json, requests, time
from datetime import datetime, timezone
from pathlib import Path

BASE = Path.home() / "savant"
LOG = BASE / "logs/cloudbridge.log"
AI_URL = "http://127.0.0.1:8000/api/ai"
CLOUD_SIM = BASE / "cloud_sim"

### — Savant Insight —
# Purpose: log — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:11:53
def log(msg: str):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(f"[{datetime.now(timezone.utc).isoformat()}] {msg}\n")

### — Savant Insight —
# Purpose: local_cloud_sync — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:11:53
def local_cloud_sync():
    src = BASE / "context/research"
    dst = CLOUD_SIM
    dst.mkdir(parents=True, exist_ok=True)
    count = 0
    for root, _, files in os.walk(src):
        for f in files:
            src_path = os.path.join(root, f)
            dst_path = os.path.join(dst, f)
            try:
                os.system(f"cp -f '{src_path}' '{dst_path}'")
                count += 1
            except Exception as e:
                log(f"❌ Sync error on {f}: {e}")
    log(f"☁️ Local cloud simulation sync completed: {count} files.")

### — Savant Insight —
