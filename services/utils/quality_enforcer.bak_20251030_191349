#!/usr/bin/env python3
"""
SAVANT QUALITY ENFORCER v1.2
Evaluates all Savant scripts to ensure compliance with SQS (Phase 140 standard).
"""
import os, re, hashlib, json, time

SQS_PHASE = 140
SQS_KEYWORDS = ["async", "modular", "robust", "fractal", "error handling", "logging"]

### — Savant Insight —
# Purpose: evaluate_script — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:08:30
def evaluate_script(path):
    text = open(path, "r", errors="ignore").read()
    score = 0
    if len(text) > 400: score += 20
    if "class " in text: score += 20
    if any(k in text for k in SQS_KEYWORDS): score += 30
    if re.search(r"try\s*:\s*\n", text): score += 10
    if "def main" in text: score += 20
    return min(score, 100)

### — Savant Insight —
# Purpose: enforce_quality — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:08:30
def enforce_quality(base="~/savant/services"):
    base = os.path.expanduser(base)
    report = []
    for root,_,files in os.walk(base):
        for f in files:
            if f.endswith(".py"):
                path = os.path.join(root,f)
                score = evaluate_script(path)
                status = "✅ OK" if score>=SQS_PHASE else "⚠️ Upgrade Required"
                report.append({"path":path,"score":score,"status":status})
    with open(f"{base}/utils/quality_report.json","w") as fp:
        json.dump(report,fp,indent=2)
    print(f"📘 Quality Report generated → {base}/utils/quality_report.json")
    weak = [r for r in report if r["status"].startswith("⚠️")]
    if weak:
        print(f"🚨 {len(weak)} scripts below standard:")
        for w in weak: print("   ", w["path"], "→ score", w["score"])
    else:
        print("✅ All scripts meet the Savant Quality Standard.")

if __name__=="__main__": enforce_quality()


