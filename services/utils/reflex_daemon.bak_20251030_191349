import json, os, time, requests, shutil, psutil, subprocess
from datetime import datetime, timezone
from pathlib import Path

BASE = Path.home() / "savant"
LOG = BASE / "logs/reflex_audit.json"
VALIDATE_URL = "http://127.0.0.1:7070/api/reflex/validate"
CLOUD_URL = "http://127.0.0.1:7070/api/cloud/sync"

### — Savant Insight —
# Purpose: timestamp — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:11:23
def timestamp(): return datetime.now(timezone.utc).isoformat()

### — Savant Insight —
# Purpose: log — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:11:23
def log(msg, path=LOG):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as f:
        f.write(json.dumps({"time": timestamp(), **msg}) + "\n")

### — Savant Insight —
# Purpose: system_ok — auto-annotated by Savant DocSynth
# Added 2025-10-30 19:11:23
def system_ok(sys):
    return sys.get("disk",0)<95 and sys.get("mem",0)<90

### — Savant Insight —
